---
interface Props {
  items: { n: string; l: string }[];
}
const { items } = Astro.props;
---

<dl class="nums">
  {items.map((i) => (
    <div>
      <dt>{i.n}</dt>
      <dd>{i.l}</dd>
    </div>
  ))}
</dl>

<style>
  .nums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 24px;
    margin: 0;
  }
  div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  dt {
    font-family: var(--display);
    font-weight: 400;
    font-size: 2.1rem;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  dd {
    margin: 0;
    color: var(--soft);
    font-size: 0.92rem;
  }
</style>
