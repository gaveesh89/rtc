---
export interface Qa {
  q: string;
  a: string;
}
interface Props {
  items: Qa[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>

<style>
  details {
    border-bottom: 1px solid var(--rule);
    padding: 12px 0;
  }
  details:first-of-type {
    border-top: 1px solid var(--rule);
  }
  summary {
    cursor: pointer;
    font-family: var(--display);
    font-size: 1.08rem;
  }
  p {
    margin: 8px 0 0;
    color: var(--soft);
    max-width: 60ch;
  }
</style>
